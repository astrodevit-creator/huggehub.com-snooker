{
  "entities": {
    "users": {
      "title": "Users",
      "description": "System workers and administrators with authentication details and roles",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "WORKER"] },
        "active": { "type": "boolean" },
        "created_at": { "type": "string" },
        "created_by": { "type": "string" },
        "last_login": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["user_id", "name", "email", "role", "active"]
    },
    "tables": {
      "title": "Snooker Tables",
      "description": "Mini snooker tables configuration and current status",
      "type": "object",
      "properties": {
        "table_id": { "type": "string" },
        "name": { "type": "string" },
        "active": { "type": "boolean" },
        "hourly_rate": { "type": "number" },
        "minimum_price": { "type": "number" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["table_id", "name", "active", "hourly_rate", "minimum_price"]
    },
    "customers": {
      "title": "Customers",
      "description": "Players with loan balance, promo cycles, and visit history",
      "type": "object",
      "properties": {
        "customer_id": { "type": "string" },
        "name": { "type": "string" },
        "normalized_name": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "active": { "type": "boolean" },
        "today_games_count": { "type": "number" },
        "promo_cycle_count": { "type": "number" },
        "lifetime_games": { "type": "number" },
        "total_paid_dh": { "type": "number" },
        "open_loan_balance_dh": { "type": "number" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["customer_id", "name", "normalized_name", "active"]
    },
    "games": {
      "title": "Games",
      "description": "Active and completed snooker games with duration and pricing",
      "type": "object",
      "properties": {
        "game_id": { "type": "string" },
        "session_id": { "type": "string" },
        "table_id": { "type": "string" },
        "customer_id": { "type": "string" },
        "player_name": { "type": "string" },
        "start_time": { "type": "string" },
        "end_time": { "type": "string" },
        "duration_seconds": { "type": "number" },
        "duration_minutes": { "type": "number" },
        "final_price": { "type": "number" },
        "payment_status": { "type": "string", "enum": ["PENDING", "PAID", "LOAN", "LOAN_PAID", "FREE"] },
        "status": { "type": "string", "enum": ["RUNNING", "CLOSED", "CANCELLED"] },
        "started_by": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["game_id", "session_id", "table_id", "player_name", "start_time", "status", "payment_status"]
    },
    "loans": {
      "title": "Loans",
      "description": "Customer debts, credit advances, and repayment tracking",
      "type": "object",
      "properties": {
        "loan_id": { "type": "string" },
        "game_id": { "type": "string" },
        "session_id": { "type": "string" },
        "customer_id": { "type": "string" },
        "player_name": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["OPEN", "PAID", "CANCELLED"] },
        "created_at": { "type": "string" },
        "created_by": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["loan_id", "session_id", "customer_id", "player_name", "amount", "status"]
    },
    "waiting_list": {
      "title": "Waiting List",
      "description": "Queue entries for players waiting for an available table",
      "type": "object",
      "properties": {
        "waiting_id": { "type": "string" },
        "session_id": { "type": "string" },
        "customer_id": { "type": "string" },
        "player_name": { "type": "string" },
        "preferred_table": { "type": "string" },
        "status": { "type": "string", "enum": ["WAITING", "SEATED", "CANCELLED", "NO_SHOW"] },
        "added_at": { "type": "string" },
        "added_by": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["waiting_id", "session_id", "player_name", "status"]
    },
    "sessions": {
      "title": "Daily Sessions",
      "description": "Daily accounting sessions and financial shift totals",
      "type": "object",
      "properties": {
        "session_id": { "type": "string" },
        "date": { "type": "string" },
        "opened_at": { "type": "string" },
        "opened_by": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED"] },
        "total_games": { "type": "number" },
        "total_paid": { "type": "number" },
        "new_loans": { "type": "number" },
        "old_loans_collected": { "type": "number" },
        "reste": { "type": "number" }
      },
      "required": ["session_id", "date", "status", "total_games", "total_paid"]
    },
    "settings": {
      "title": "App Settings",
      "description": "Club pricing, promotional offers, and operating configurations",
      "type": "object",
      "properties": {
        "timezone": { "type": "string" },
        "hourly_rate": { "type": "number" },
        "minimum_price": { "type": "number" },
        "updated_at": { "type": "string" }
      },
      "required": ["timezone", "hourly_rate", "minimum_price"]
    },
    "audit_logs": {
      "title": "Audit Logs",
      "description": "Security and action audit trails for financial actions",
      "type": "object",
      "properties": {
        "audit_id": { "type": "string" },
        "timestamp": { "type": "string" },
        "user_email": { "type": "string" },
        "user_role": { "type": "string" },
        "action": { "type": "string" },
        "entity_type": { "type": "string" },
        "entity_id": { "type": "string" }
      },
      "required": ["audit_id", "timestamp", "action", "entity_type", "entity_id"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
